&lt;/span&gt;&lt;span class=&quot;nv&quot;&gt;\end&lt;/span&gt;&lt;span class=&quot;p&quot;&gt;{&lt;/span&gt;&lt;span class=&quot;nb&quot;&gt;aligned&lt;/span&gt;&lt;span class=&quot;p&quot;&gt;}$$&lt;/span&gt;
